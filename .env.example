# Required, no default: where recently added media is read from.
# tracearr (recommended) covers Plex, Jellyfin and Emby; tautulli is Plex only.
MEDIA_SOURCE=tracearr

# Required when MEDIA_SOURCE=tracearr
# Docker Compose network: http://tracearr:3000
# The token is created in Tracearr's UI and looks like trr_pub_...
TRACEARR_URL=http://tracearr:3000
TRACEARR_API_KEY=/run/secrets/tracearr_api_key

# Required when MEDIA_SOURCE=tautulli
# Docker Compose network: http://tautulli:8181
# Local/devcontainer: use a host-reachable URL (e.g., http://localhost:8181 or host gateway IP)
# TAUTULLI_URL=http://tautulli:8181
# TAUTULLI_API_KEY=your_tautulli_api_key_here

# Optional (uncomment and customize as needed)
# DAYS_BACK=7
# CRON_SCHEDULE=0 16 * * SUN
# RUN_ONCE=true
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# MEDIA_SERVER_URL=https://app.plex.tv
# MEDIA_SERVER_ID=
# LOG_LEVEL=INFO
# EXCLUDED_MEDIA_TYPES=track,album
# ENABLE_HEALTHCHECK=true
# HEALTH_HOST=127.0.0.1
# HEALTH_PORT=8080
# INITIAL_BATCH_SIZE=
# TZ=UTC
